# The B70 vLLM changes live on two fork branches (one commit per change). docker/overlay.sh exports the files each branch
# changes against its base; the Dockerfile and serve.sh copy them over the stock image. Bump: rebase the branches, set the SHAs.
VLLM_BASE_REPO=https://github.com/vllm-project/vllm
VLLM_BASE=5df63a7203cdb9328d824a27b682e77c7b9928be        # tag v0.32.0
VLLM_REPO=https://github.com/riceharvest/vllm
VLLM_REF=e7c147e3a81a469b17bd6540acbc508d819adc1b         # branch b70/v0.32
XK_BASE_REPO=https://github.com/vllm-project/vllm-xpu-kernels
XK_BASE=ddf336d86e3c8602888572a3502f951abd51df12          # python files = wheel 0.1.15.4 in the base image (no upstream tag)
XK_REPO=https://github.com/riceharvest/vllm-xpu-kernels
XK_REF=2d0d2dfb60a2b8ba63f87b4f15caad0b533c3889           # branch b70/v0.1.15.4
